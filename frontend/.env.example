# Salin menjadi ".env.local" (laptop) atau ".env.production.local" (saat build untuk server).
# Alamat API backend Laravel, tanpa garis miring di akhir.
#   Laptop : http://localhost:8000/api
#   Server : https://api-qc.workshop-up2w3.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Kosongkan bila aplikasi dipasang di root domain (disarankan).
NEXT_PUBLIC_BASE_PATH=

# Supabase Storage untuk file sertifikat kalibrasi (anon key memang boleh ada di frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
